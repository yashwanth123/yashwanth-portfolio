# Inbox that receives contact form messages.
# FormSubmit is called from the browser, so the first production
# submission sends an activation email that must be confirmed.
CONTACT_EMAIL=

# Optional. Public-safe Web3Forms access key.
# Preferred when set because it keeps the inbox address off the client.
WEB3FORMS_ACCESS_KEY=

# Optional. GitHub token for higher API rate limits when fetching repos.
GITHUB_TOKEN=
